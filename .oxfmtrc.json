{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 140,
  "tabWidth": 4,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": ["src-tauri/target/**", "src-tauri/gen/**", "public/assets/**", "assets/**", "dist/**", "package-lock.json", "src/ui/frames.css"]
}
